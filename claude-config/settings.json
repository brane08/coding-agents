{
  "includeCoAuthoredBy": false,
  "model": "opusplan",
  "effortLevel": "low",
  "autoMemoryEnabled": false,
  "autoCompact": true,
  "theme": "light",
  "agentPushNotifEnabled": false,
  "notifyOnAgentStop": true,
  "cleanupPeriodDays": 5,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "low",
    "CLAUDE_CODE_TMPDIR": "/tmp"
  },
  "ignorePatterns": [
    "**/target/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/__pycache__/**",
    "**/*.class",
    "**/*.jar",
    "**/*.war",
    "**/dist/**",
    "**/.venv/**",
    "**/.gradle/**",
    "**/build/**"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",

      "Bash(java *)",
      "Bash(javac *)",
      "Bash(javap *)",
      "Bash(jar -tf *)",
      "Bash(jar -xf *)",
      "Bash(jar xf *)",
      "Bash(jar tf *)",
      "Bash(unzip -p *)",
      "Bash(unzip -l *)",
      "Bash(unzip *)",
      "Bash(javap -c *)",
      "Bash(javap -p *)",
      "Bash(javap -verbose *)",

      "Bash(mvn:*)",
      "Bash(./mvnw:*)",
      "Bash(mvn clean *)",
      "Bash(mvn test *)",
      "Bash(mvn test)",
      "Bash(mvn compile *)",
      "Bash(mvn verify *)",
      "Bash(mvn verify)",
      "Bash(mvn package *)",
      "Bash(mvn package)",
      "Bash(mvn -pl *)",
      "Bash(mvn -pl * test*)",
      "Bash(mvn -pl * verify*)",
      "Bash(mvn -pl * -Dtest=*)",
      "Bash(mvn -Dtest=* test*)",
      "Bash(mvn -Dtest=* -pl *)",
      "Bash(mvn -f * test*)",
      "Bash(mvn -f * verify*)",
      "Bash(mvn -f * -Dtest=*)",
      "Bash(mvn surefire:test*)",
      "Bash(mvn failsafe:integration-test*)",
      "Bash(mvn dependency:tree *)",
      "Bash(mvn dependency:resolve *)",
      "Bash(mvn dependency:sources *)",
      "Bash(mvn spring-boot:run*)",
      "Bash(mvn install -pl *)",
      "Bash(mvn install -DskipTests *)",
      "Bash(mvn -pl * install *)",
      "Bash(mvn -pl * install -DskipTests*)",
      "Bash(mvn clean install -DskipTests *)",
      "Bash(mvn -am -pl * test*)",
      "Bash(mvn -am -pl * -Dtest=* test*)",
      "Bash(mvn -am -pl * -Dtest=* -Dsurefire.*)",
      "Bash(mvn -am -pl * -Dsurefire.* test*)",
      "Bash(mvn -am -pl * verify*)",
      "Bash(mvn -am -pl * -Dtest=* verify*)",
      "Bash(mvn -pl * -am -Dtest=* test*)",
      "Bash(mvn -pl * -am -Dtest=* -Dsurefire.*)",
      "Bash(mvn -pl * -am test*)",
      "Bash(mvn -pl * -am verify*)",
      "Bash(mvn quarkus:dev*)",
      "Bash(mvn -q quarkus:dev:*)",
      "Bash(mvn -q flyway:migrate)",
      "Bash(mvn -q flyway:info)",
      "Bash(mvn flyway:info*)",
      "Bash(gradle test *)",
      "Bash(gradle test)",
      "Bash(gradle build *)",
      "Bash(gradle run *)",
      "Bash(gradle bootRun*)",
      "Bash(gradle quarkusDev*)",
      "Bash(gradle *Test*)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew test)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew run *)",
      "Bash(./gradlew bootRun*)",
      "Bash(./gradlew quarkusDev*)",
      "Bash(./gradlew *Test*)",
      "Bash(./gradlew :*)",

      "Bash(pytest *)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright codegen*)",
      "Bash(npx playwright show-report*)",
      "Bash(npm install)",
      "Bash(npm run:*)",
      "Bash(npm run *)",
      "Bash(ng serve:*)",
      "Bash(ng build:*)",
      "Bash(npx *)",

      "Bash(bash ~/.claude/skills/psql-select/select.sh *)",
      "Bash(bash ~/.claude/skills/mvn-build/build.sh*)",
      "Bash(bash ~/.claude/skills/mvn-test/test.sh*)",
      "Bash(bash ~/.claude/skills/quarkus-dev/dev.sh*)",
      "Bash(bash ~/.claude/skills/flyway-check/flyway-check.sh*)",
      "Bash(bash $CLAUDE_CONFIG_DIR/skills/psql-select/select.sh *)",
      "Bash(bash $CLAUDE_CONFIG_DIR/skills/mvn-build/build.sh*)",
      "Bash(bash $CLAUDE_CONFIG_DIR/skills/mvn-test/test.sh*)",
      "Bash(bash $CLAUDE_CONFIG_DIR/skills/quarkus-dev/dev.sh*)",
      "Bash(bash $CLAUDE_CONFIG_DIR/skills/flyway-check/flyway-check.sh*)",

      "Bash(git add *)",
      "Bash(git add:*)",
      "Bash(git commit *)",
      "Bash(git commit:*)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git diff:*)",
      "Bash(git log *)",
      "Bash(git log:*)",
      "Bash(git stash *)",
      "Bash(git stash pop*)",
      "Bash(git rm *)",
      "Bash(git mv *)",

      "Bash(kill -9 *)",
      "Bash(kill -15 *)",
      "Bash(kill *)",
      "Bash(pkill -f *)",
      "Bash(fuser -k *)",
      "Bash(lsof -ti *)",
      "Bash(lsof -i *)",

      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(find . *)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(pwd*)",
      "Bash(date*)",
      "Bash(env*)",
      "Bash(uv *)",

      "Bash(CLAUDE_CODE_TMPDIR=* grep *)",
      "Bash(CLAUDE_CODE_TMPDIR=* cat *)",
      "Bash(CLAUDE_CODE_TMPDIR=* find *)",
      "Bash(CLAUDE_CODE_TMPDIR=* ls *)",
      "Bash(CLAUDE_CODE_TMPDIR=* head *)",
      "Bash(CLAUDE_CODE_TMPDIR=* tail *)",
      "Bash(CLAUDE_CODE_TMPDIR=* wc *)",
      "Bash(CLAUDE_CODE_TMPDIR=* sort *)",
      "Bash(CLAUDE_CODE_TMPDIR=* echo *)",
      "Bash(CLAUDE_CODE_TMPDIR=* javap *)",
      "Bash(CLAUDE_CODE_TMPDIR=* jar *)",
      "Bash(CLAUDE_CODE_TMPDIR=* unzip *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git push *)",
      "Bash(git push --tags*)",
      "Bash(git checkout *)",
      "Bash(git branch -D *)",
      "Bash(git remote *)",
      "Bash(git tag *)",
      "Bash(gradle dependencies*)",
      "Bash(./gradlew dependencies*)",
      "Bash(pip *)",
      "Bash(npm update*)",
      "Bash(npm uninstall*)",
      "Bash(go mod *)",
      "Bash(uv pip install*)",
      "Bash(psql *)",
      "Bash(docker *)",
      "mcp__*"
    ],
    "deny": [
      "Read(../**)",
      "Write(../**)",

      "Read(./.env*)",
      "Read(/**/*.env)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(**/application-prod.properties)",
      "Read(**/application-prod.yaml)",
      "Read(**/application-prod.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/*)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/*)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.m2/settings.xml)",

      "Bash(rm -rf /*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(dd *)",
      "Bash(sudo *)",
      "Bash(sudo:*)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(mkfs*)",
      "Bash(format *)",
      "Bash(git push --force*)",

      "Bash(curl *)",
      "Bash(curl:*)",
      "Bash(wget *)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",

      "Bash(mvn -q flyway:clean)",
      "Bash(mvn -q flyway:repair)",
      "Bash(mvn flyway:clean*)",
      "Bash(mvn flyway:repair*)"
    ]
  }
}
